# Copy to .env (not committed) and edit for this machine.
# Big disk for checkpoints (pi05_base is several GB) and later datasets/runs.
OPENPI_DATA_HOME=/path/to/big/disk/openpi
# Policy server port (8000 is taken on the A30 server)
# VLA_POLICY_PORT=4000
# JAX GPU memory fraction (0.9 default; 0.95 if LoRA runs out of memory)
# XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
